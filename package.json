{
  "name": "civicresolve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=@civicresolve/api\" \"wait-on http://127.0.0.1:3001/api/health && npm run dev --workspace=@civicresolve/web\"",
    "build": "npm run build --workspace=@civicresolve/shared && npm run build --workspace=@civicresolve/api && npm run build --workspace=@civicresolve/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p api/tsconfig.json --noEmit",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=@civicresolve/api",
    "eval": "npm run eval --workspace=@civicresolve/api --",
    "ai:smoke": "npm run ai:smoke --workspace=@civicresolve/api --",
    "geocode:smoke": "npm run geocode:smoke --workspace=@civicresolve/api --",
    "firestore:smoke": "npm run firestore:smoke --workspace=@civicresolve/api --",
    "lint": "eslint .",
    "secrets:check": "node scripts/secretsCheck.mjs",
    "seed": "npm run seed --workspace=@civicresolve/api --",
    "demo:samples": "npm run demo:samples --workspace=@civicresolve/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.4",
    "concurrently": "9.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.73.0",
    "wait-on": "^8.0.4"
  }
}

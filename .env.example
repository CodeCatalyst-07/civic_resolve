# ==============================================================================
# CivicResolve Environment Configuration Template
# Copy to .env for local development. Never commit real credentials to git!
# ==============================================================================

# Node runtime environment (development | production | test)
NODE_ENV=development

# Local API Server port
PORT=3001

# AI Triage Provider: 'mock' (default), 'jarvis', or 'gemini'
AI_PROVIDER=mock

# Jarvis Labs (Gemma 4 via OpenAI-compatible endpoint)
# Required ONLY when AI_PROVIDER=jarvis
JARVISLABS_API_KEY=your_jarvislabs_api_key_here
JARVIS_BASE_URL=https://models.jarvislabs.net/v1
JARVIS_MODEL=gemma-4-31b-it

# Google Gemini Official API
# Required ONLY when AI_PROVIDER=gemini
# Recommended current models: gemini-3.5-flash-lite or gemini-3.8-flash (gemini-2.5-flash is legacy)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistence Driver: 'memory' (default, in-memory) or 'firestore' (production)
REPO_DRIVER=memory

# Firebase Admin Service Account JSON string or base64-encoded string
# Required ONLY when REPO_DRIVER=firestore
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Google Maps Server Key (Optional: for server-side geocoding/reverse geocoding)
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# Daily budget quota for AI inference calls (integer, default: 200)
AI_DAILY_BUDGET=200

# AI timeout in milliseconds (default: 15000 = 15 seconds)
AI_TIMEOUT_MS=15000

# AI max output tokens (default: 1000)
AI_MAX_TOKENS=1000

# Disable reasoning/thinking for Gemma 4 to reduce latency (default: true)
AI_DISABLE_THINKING=true

# AI cache max entries (default: 200)
AI_CACHE_MAX_ENTRIES=200

# AI cache TTL in milliseconds (default: 3600000 = 1 hour)
AI_CACHE_TTL_MS=3600000

# Geocoding API timeout in milliseconds (default: 5000 = 5 seconds)
GEOCODE_TIMEOUT_MS=5000

# Rate limiting window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per rate-limiting window (default: 100)
RATE_LIMIT_MAX=100

# Allowed CORS origins for local development (comma-separated, e.g. http://localhost:5173)
# Leave empty in production on Vercel as web and API share the same origin.
ALLOWED_ORIGINS=http://localhost:5173

# Web Client Public Variables (Vite)
# Restricted by HTTP referrer in Google Cloud Console. Optional for map widget.
VITE_GOOGLE_MAPS_BROWSER_KEY=your_maps_browser_key_here
VITE_GOOGLE_MAPS_MAP_ID=your_maps_map_id_here

# Demo Authority Access Code
# Secret code required for municipal officer actions in demo mode.
DEMO_AUTHORITY_CODE=change-me-demo-code

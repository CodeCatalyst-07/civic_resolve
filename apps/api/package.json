{
  "name": "@civicresolve/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/eval.ts",
    "ai:smoke": "tsx scripts/aiSmoke.ts",
    "geocode:smoke": "tsx scripts/geocodeSmoke.ts",
    "firestore:smoke": "tsx scripts/firestoreSmoke.ts",
    "seed": "tsx scripts/seed.ts",
    "demo:samples": "tsx scripts/demoSamples.ts",
    "demo:lifecycle": "tsx scripts/demoLifecycle.ts",
    "test:firestore": "FIRESTORE_EMULATOR_HOST=localhost:8080 vitest run tests/unit/repo/firestore.test.ts"
  },
  "dependencies": {
    "@civicresolve/shared": "*",
    "@google/genai": "3.6.1",
    "cors": "2.8.5",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "firebase-admin": "14.5.1",
    "helmet": "8.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.13.4",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "supertest": "7.1.3",
    "tsx": "4.19.3",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}

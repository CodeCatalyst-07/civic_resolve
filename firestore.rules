rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CivicResolve Backend-Only Security Policy:
    // Direct client read and write access is completely denied.
    // All civic grievances and triage updates are strictly handled through
    // the authenticated backend API using the Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
